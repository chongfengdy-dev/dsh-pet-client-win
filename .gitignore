# 依赖
node_modules/

# 编译产物
*.exe
*.dll
*.pdb
nimcache/

# 运行时日志与 PID
logs/
run/
*.log

# 运行时状态
term-state.json
pet-state.json

# 敏感信息
.credentials.yaml
*credentials*.yaml
platform-token.json

# 本机专有的回滚备份（含用户名，不入库）
config/removed-wsl-autostart.txt

# 迁移备份目录
.migrate-backup*/
.migration-backup*/

# 系统垃圾
Thumbs.db
desktop.ini

# 运行时图片背景资源（不入库，与 dsh-pet-client 一致）
terminal-server/backgrounds/

# 临时备份文件（*.bak-<时间戳>），不入库
*.bak-*
